# Cloudflare Pages headers.
# Next.js writes generated images without a file extension, so set their type here.
/apple-icon
  Content-Type: image/png
/opengraph-image
  Content-Type: image/png
/weekend/*/opengraph-image
  Content-Type: image/png

# Long-cache the hashed build assets.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
